# COMPOSE_FILE is auto-selected by talosctl based on GPU + DEFAULT_MODEL.
# Do not set it manually unless you need to override.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.rocm.yml:docker-compose.model.gemma-4-31b-it.yml

# vLLM server (OpenAI-compatible API)
VLLM_BASE_URL=http://localhost:8080/v1

# Default Model (used by llamacpp in compose)
# talosctl auto-selects a model overlay based on this filename
# e.g. gemma-4-31B-it-UD-Q4_K_XL.gguf → docker-compose.model.gemma-4-31b.yml
# Leave empty or set to an Ollama model name to skip llamacpp
DEFAULT_MODEL=gemma-4-31B-it-UD-Q4_K_XL.gguf

# TALOS_MODEL: model name sent to the Gate for LLM routing
# Ollama models (colon suffix):  gemma4:31b-cloud, minimax-m2.7:cloud, glm-5.1:cloud
# llamacpp models (.gguf):       gemma-4-31B-it-UD-Q4_K_XL.gguf
# Together AI models:             together_ai/meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
TALOS_MODEL=gemma4:31b-cloud

# --- LLAMACPP ENGINE CONFIGURATION ---
# AMD (ROCm): ghcr.io/ggml-org/llama.cpp:server-rocm
# NVIDIA (CUDA): ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# GitHub personal access token (needs repo scope)
GITHUB_TOKEN=
GITHUB_USER=Redna
GITHUB_REPO=talos

# Token budget (informational — no USD cost for local vLLM)
TOTAL_BUDGET=1000000

# --- Optional ---

# API key for vLLM (leave as token if your server has no auth)
VLLM_API_KEY=local-vllm-key

# Smaller/faster model on the same vLLM server (for consciousness, summaries)
# TALOS_MODEL_LIGHT=Qwen/Qwen2.5-7B-Instruct

# Separate model for code-heavy tasks (defaults to TALOS_MODEL if unset)
# TALOS_MODEL_CODE=

# Worker count (default: 5)
# TALOS_MAX_WORKERS=5

# Task timeouts in seconds
# TALOS_SOFT_TIMEOUT_SEC=600
# TALOS_HARD_TIMEOUT_SEC=1800

# Max LLM rounds per task (default: 60)
# TALOS_MAX_ROUNDS=60

# Run pytest before git push? (1 = yes, 0 = no)
# TALOS_PRE_PUSH_TESTS=1

# --- SECRET SCANNING ---
# The container pre-commit hook includes trufflehog (no host install needed).
# For host-side pre-push scanning, install trufflehog:
#   brew install trufflehog
#   or: https://github.com/trufflesecurity/trufflehog/releases
# Then run: ./scripts/setup_host_hooks.sh

# --- OLLAMA ---
# Ollama host address (reachable from Docker containers)
OLLAMA_HOST=host.docker.internal:11434

TALOS_DRIVE_ROOT=/app/.talos
# Path to this repo (so it works on itself)
TALOS_REPO_DIR=/app
# Git branches used by the agent
TALOS_BRANCH_DEV=talos
TALOS_BRANCH_STABLE=talos-stable

TALOS_CONTEXT_WINDOW=71680
TALOS_ENABLE_THINKING=1
TALOS_DISABLE_TOOLS=0