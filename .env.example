# Talos Runtime Environment Configuration
# Copy this file to .env and configure for your setup

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Docker compose overlay selection
# Base: docker-compose.yml
# GPU: docker-compose.yml:docker-compose.rocm.yml OR docker-compose.yml:docker-compose.cuda.yml
# Examples:
#   COMPOSE_FILE=docker-compose.yml
#   COMPOSE_FILE=docker-compose.yml:docker-compose.rocm.yml
#   COMPOSE_FILE=docker-compose.yml:docker-compose.rocm.full.yml
#   COMPOSE_FILE=docker-compose.yml:docker-compose.gemma.yml
COMPOSE_FILE=docker-compose.yml

# Model configuration - must match a .gguf file in ./models/
DEFAULT_MODEL=model.gguf
TALOS_MODEL=${DEFAULT_MODEL}

# llama.cpp server image
# Options:
#   ghcr.io/ggml-org/llama.cpp:server-rocm   (AMD ROCm)
#   ghcr.io/ggml-org/llama.cpp:server-cuda   (NVIDIA CUDA)
#   ghcr.io/ggml-org/llama.cpp:server        (CPU only)
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm

# =============================================================================
# TALOS SETTINGS
# =============================================================================

# Context window size for the model
TALOS_CONTEXT_WINDOW=71680

# =============================================================================
# API KEYS
# =============================================================================

# TogetherAI API key (required for LLM inference)
TOGETHERAI_API_KEY=

# GitHub Personal Access Token (required for agent to push code)
# Create at: https://github.com/settings/tokens
# Needs: repo (full control)
# GITHUB_TOKEN=

# GitHub SSH Private Key (alternative to token for pushing)
# Paste the full private key here (-----BEGIN OPENSSH PRIVATE KEY----- ... -----END OPENSSH PRIVATE KEY-----)
# This is preferred in ephemeral environments as it can be stored as a Lightning AI secret
GITHUB_SSH_KEY=

# Audio transcription API key (optional, defaults to TOGETHERAI_API_KEY)
AUDIO_API_KEY=

# =============================================================================
# BUDGET & LIMITS
# =============================================================================

# Daily budget limit in USD
DAILY_BUDGET_LIMIT=5.00

# =============================================================================
# OBSERVABILITY (Optional)
# =============================================================================

# Directory for LLM call logs
# RUNTIME_LOG_DIR=./llm_logs

# Memory directory for agent state
# MEMORY_DIR=./memory

# =============================================================================
# TELEGRAM (Optional)
# =============================================================================

# Telegram bot token for notifications
# TELEGRAM_BOT_TOKEN=

# Telegram chat ID for notifications
# TELEGRAM_CHAT_ID=0

# =============================================================================
# CONTAINER SETTINGS
# =============================================================================

# User/group ID for file permissions
PUID=1000
PGID=1000