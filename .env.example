# --- MODEL CONFIGURATION ---

# DEFAULT_MODEL: llamacpp model file (.gguf) or empty to skip llamacpp.
# When set to a .gguf filename, talosctl auto-selects the matching compose overlay.
# Leave empty to run without llamacpp (Ollama-only).
DEFAULT_MODEL=

# TALOS_MODEL: model name the Spine sends to the Gate for LLM routing.
# This is what the agent actually uses for LLM calls.
# Ollama models:     gemma4:31b-cloud, minimax-m2.7:cloud, glm-5.1:cloud
# llamacpp models:   gemma-4-31B-it-UD-Q4_K_XL.gguf
# Together AI:       together_ai/meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
TALOS_MODEL=gemma4:31b-cloud

# LLAMACPP_IMAGE: Docker image for llamacpp (only used if DEFAULT_MODEL is set)
# AMD (ROCm):     ghcr.io/ggml-org/llama.cpp:server-rocm
# NVIDIA (CUDA):  ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm

# OLLAMA_HOST: Ollama address reachable from Docker containers
OLLAMA_HOST=host.docker.internal:11434

# TALOS_CONTEXT_WINDOW: context window size passed to the Gate
TALOS_CONTEXT_WINDOW=71680

# --- CREDENTIALS ---

# Together AI API key (optional, for cloud LLM fallback)
TOGETHERAI_API_KEY=

# Telegram bot token (from @BotFather, optional)
TELEGRAM_BOT_TOKEN=

# GitHub personal access token (needs repo scope)
GITHUB_TOKEN=
GITHUB_USER=Redna
GITHUB_REPO=talos

# --- BUDGET ---

# Daily budget limit for paid API calls (USD)
DAILY_BUDGET_LIMIT=5.00

# --- AGENT CONFIGURATION ---

TALOS_DRIVE_ROOT=/app/.talos
TALOS_REPO_DIR=/app
TALOS_BRANCH_DEV=talos
TALOS_BRANCH_STABLE=talos-stable

# User/group IDs inside the container
PUID=1000
PGID=1000

# --- SECRET SCANNING ---
# The container pre-commit hook includes trufflehog (no host install needed).
# For host-side pre-push scanning, install trufflehog:
#   brew install trufflehog
# Then run: ./scripts/setup_host_hooks.sh