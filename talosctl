    while True:
        _draw_dashboard()
        try:
            time.sleep(5)
        except KeyboardInterrupt:
            break

def _draw_dashboard():
    print("\033[2J\033[H", end="")

    compose_args = get_compose_args(cached=True)
    env = load_env(RUNTIME_DIR / ".env")
    # Clean up environment to ensure .env file values take precedence over host shell
    for key in ["TALOS_MODEL", "TALOS_CLOUD_MODEL", "DEFAULT_MODEL"]:
        if key in os.environ:
            del os.environ[key]
    
    model = env.get("DEFAULT_MODEL", "unknown")

    now = time.strftime("%H:%M:%S")

    print(f"\033[1m  TALOS MONITOR  {now}\033[0m")
    print(f"  Model: {model}")
    print()

    print("\033[1m  CONTAINERS\033[0m")
    container_data = _container_status(compose_args)
    for name, status, health in container_data:
        icon = {"running": "\033[32m●\033[0m", "exited": "\033[31m●\033[0m"}.get(status, "\033[33m●\033[0m")
        h = f" ({health})" if health else ""
        print(f"  {icon} {name:16s} {status}{h}")
    print()

    print("\033[1m  SPINE (localhost:4001)\033[0m")
    spine = _spine_info()
    if spine:
        ctx_bar = _bar(spine.get("context_pct", 0) / 100, 20)
        print(f"  Context: {ctx_bar} {spine.get('context_pct', 0):.0f}%")
        print(f"  Turn: {spine.get('turn', 0)}   Tokens: {spine.get('tokens_used', 0)}   Messages: {spine.get('message_count', 0)}   Notices: {spine.get('queued_notices', 0)}")
        focus = spine.get("current_focus", "")
        if focus:
            print(f"  Focus: {focus[:60]}")
    else:
        print("  \033[33mUnreachable\033[0m")
    print()

    print("\033[1m  VERSION TRACKING\033[0m")
    for label, path in [("Candidate", Path("/spine/last_candidate_commit")), ("Stable", Path("/spine/last_stable_commit"))]:
        if path.exists():
            sha = path.read_text().strip()[:8]
            print(f"  {label}: {sha}")
        else:
            print(f"  {label}: —")
    print()

    stats = load_runtime_stats()
    print("\033[1m  LAZARUS\033[0m")
    print(f"  Consecutive failures: {stats.get('consecutive_failures', 0)}   Last task: {stats.get('last_task_id', '—')}")
    print()

    wd_status, wd_health = _watchdog_status()
    if wd_status == "running":
        phase = wd_health.get("phase", "") if wd_health else ""
        pid = int(PID_FILE.read_text()) if PID_FILE.exists() else "?"
        print(f"  Watchdog: \033[32mrunning\033[0m (PID: {pid}){f' — {phase}' if phase else ''}")
    elif wd_status == "failed":
        error = wd_health.get("error", "unknown") if wd_health else "unknown"
        print(f"  Watchdog: \033[31mfailed\033[0m — {error}")
    elif wd_status == "stale":
        print("  Watchdog: \033[33mstale\033[0m (no health update in 2+ minutes)")
    else:
        print("  Watchdog: \033[33mnot running\033[0m")

    print("\n  \033[2mCtrl+C to exit\033[0m")

def _container_status(compose_args):
    result = subprocess.run(
        f"docker compose {compose_args} ps --format json",
        shell=True, cwd=str(RUNTIME_DIR), capture_output=True, text=True
    )
    rows = []
    for line in result.stdout.strip().splitlines():
        try:
            c = json.loads(line)
            rows.append((c.get("Name", "?"), c.get("State", "?"), c.get("Health", "")))
        except:
            pass
    if not rows:
        res = subprocess.run(
            f"docker compose {compose_args} ps",
            shell=True, cwd=str(RUNTIME_DIR), capture_output=True, text=True
        )
        for line in res.stdout.strip().splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 3:
                rows.append((parts[0], parts[2], ""))
    return rows

def _spine_info():
    try:
        resp = urllib.request.urlopen('http://localhost:4001/state', timeout=3)
        return json.loads(resp.read())
    except:
        return None

def _bar(pct, width):
    filled = int(pct * width)
    filled = max(0, min(width, filled))
    if pct < 0.5:
        color = "\033[32m"
    elif pct < 0.85:
        color = "\033[33m"
    else:
        color = "\033[31m"
    return f"{color}{'█' * filled}{'░' * (width - filled)}\033[0m"

def _watchdog_status():
    if not PID_FILE.exists():
        return "not_running", None
    pid = int(PID_FILE.read_text())
    try:
        os.kill(pid, 0)
    except:
        return "not_running", None
    if not HEALTH_FILE.exists():
        return "running", None
    try:
        health = json.loads(HEALTH_FILE.read_text())
        age = time.time() - health.get("ts", 0)
        if age > 120:
            return "stale", health
        return health.get("status", "running"), health
    except:
        return "running", None

def status():
    compose_args = get_compose_args(cached=True)
    container_data = _container_status(compose_args)
    for name, s, health in container_data:
        h = f" ({health})" if health else ""
        print(f"  {name}: {s}{h}")
    wd_status, wd_health = _watchdog_status()
    if wd_status == "running":
        phase = wd_health.get("phase", "") if wd_health else ""
        pid = int(PID_FILE.read_text()) if PID_FILE.exists() else "?"
        print(f"Watchdog: \033[32mrunning\033[0m (PID: {pid}){f' — {phase}' if phase else ''}")
    elif wd_status == "failed":
        error = wd_health.get("error", "unknown") if wd_health else "unknown"
        print(f"Watchdog: \033[31mfailed\033[0m — {error}")
    elif wd_status == "stale":
        print("Watchdog: \033[33mstale\033[0m (no health update in 2+ minutes)")
    else:
        print("Watchdog: not running")

def pause():
    if _send_api_command("pause"):
        print("Agent paused.")
    else:
        sys.exit(1)

def resume():
    if _send_api_command("resume"):
        print("Agent resumed.")
    else:
        sys.exit(1)

def step():
    if _send_api_command("step"):
        print("Step triggered. Turn will advance when gate returns.")
    else:
        sys.exit(1)

def events(tail=50):
    ls_result = subprocess.run(
        "docker exec talos_agent ls -t /spine/events/*.jsonl",
        shell=True, capture_output=True, text=True
    )
    if ls_result.returncode != 0 or not ls_result.stdout.strip():
        print("[talosctl] No event files found. Is the agent running?")
        sys.exit(1)
    latest_file = ls_result.stdout.strip().splitlines()[0]
    cmd = ["docker", "exec", "talos_agent", "tail", "-n", str(tail), latest_file]
    subprocess.run(cmd, shell=False)

def reset(hard=False, preserve=False):
    compose_args = get_compose_args(cached=True)
    memory_dir = MEMORY_DIR
    if not hard and not preserve and memory_dir.exists():
        try:
            if any(memory_dir.iterdir()):
                print("[talosctl] Memory dir contains files. Use --hard to wipe, or --preserve to keep.")
                sys.exit(1)
        except OSError as e:
            print(f"[talosctl] Error checking memory dir: {e}")
            sys.exit(1)
        except OSError as e:
            print(f"[talosctl] Error checking memory dir: {e}")
            sys.exit(1)

    print("[talosctl] Stopping containers...")
    try:
        subprocess.run(f"docker compose {compose_args} down", shell=True, cwd=str(RUNTIME_DIR), check=True)
    except subprocess.CalledProcessError as e:
        print(f"[talosctl] Failed to stop containers: {e}")
        sys.exit(1)

    print("[talosctl] Wiping runtime state...")
    for vol_name in ("spine_observability", "talos_app"):
        vol_result = subprocess.run(
            f"docker volume ls -q -f name={vol_name}",
            shell=True, capture_output=True, text=True
        )
        for vol in vol_result.stdout.strip().splitlines():
            if vol:
                try:
                    subprocess.run(f"docker volume rm -f {vol}", shell=True, check=True)
                except subprocess.CalledProcessError as e:
                    print(f"[talosctl] Failed to remove volume {vol}: {e}")

    for d in [RUNTIME_DIR / "xray_data", RUNTIME_DIR / "llm_logs"]:
        p = Path(d)
        if p.exists():
            try:
                # Files may be owned by root (container user). Use rm -rf via subprocess
                # which can be sudoed, or just try and skip on permission error.
                result = subprocess.run(["rm", "-rf", str(p)], capture_output=True, text=True)
                if result.returncode != 0:
                    print(f"[talosctl] Warning: could not remove {p}. Skipping.")
            except OSError as e:
                print(f"[talosctl] Warning: could not remove {p}: {e}. Skipping.")

    if hard:
        print("[talosctl] Wiping memory...")
        if memory_dir.exists():
            try:
                # Files may be owned by root (container user). Use sudo rm -rf to ensure
                # complete cleanup regardless of ownership.
                result = subprocess.run(
                    ["sudo", "rm", "-rf", str(memory_dir)],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    print(f"[talosctl] Warning: could not remove {memory_dir}: {result.stderr}. Skipping.")
            except OSError as e:
                print(f"[talosctl] Warning: could not wipe memory dir: {e}. Skipping.")

    MEMORY_DIR.mkdir(parents=True, exist_ok=True)
    (RUNTIME_DIR / "xray_data").mkdir(parents=True, exist_ok=True)
    (RUNTIME_DIR / "llm_logs").mkdir(parents=True, exist_ok=True)

    print("[talosctl] Starting fresh...")
    try:
        subprocess.run(f"docker compose {compose_args} up -d --build talos xray", shell=True, cwd=str(RUNTIME_DIR), check=True)
    except subprocess.CalledProcessError as e:
        print(f"[talosctl] Failed to start containers: {e}")
        sys.exit(1)
    print("[talosctl] Reset complete. Agent started from turn 0.")

