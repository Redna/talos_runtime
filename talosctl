# --- API Helpers ---
def _send_api_command(cmd):
    url = "http://localhost:4040/api/command"
    try:
        req = urllib.request.Request(
            url,
            data=json.dumps({"command": cmd}).encode(),
            headers={"Content-Type": "application/json"},
        )
        urllib.request.urlopen(req, timeout=10)
        return True
    except Exception as e:
        print(f"Error sending command '{cmd}': {e}", file=sys.stderr)
        return False

# --- Configuration ---
RUNTIME_DIR = Path(__file__).parent.resolve()
ROOT = RUNTIME_DIR.parent
AGENT_DIR = RUNTIME_DIR / "talos"
MEMORY_DIR = RUNTIME_DIR / "memory"
RUN_DIR = Path("/tmp/talos-runtime")
PID_FILE = RUN_DIR / "watchdog.pid"
LOG_FILE = RUN_DIR / "watchdog.log"
HEALTH_FILE = RUN_DIR / "watchdog.health"

CRASH_LOG_PATH = MEMORY_DIR / "last_crash.log"
STATS_FILE = MEMORY_DIR / ".runtime_stats.json"
PENDING_NOTICES_PATH = MEMORY_DIR / "pending_system_notices.json"

# Thresholds
UPTIME_STABILITY_THRESHOLD = 300
MAX_COGNITIVE_STALL_SECONDS = 600
MAX_REVERSAL_DEPTH = 5

def ensure_run_dir():
    if not RUN_DIR.exists():
        RUN_DIR.mkdir(parents=True, exist_ok=True)

def load_runtime_stats():
    if not STATS_FILE.exists():
        return {"consecutive_failures": 0, "last_task_id": None}
    try:
        return json.loads(STATS_FILE.read_text())
    except:
        return {"consecutive_failures": 0, "last_task_id": None}

def save_runtime_stats(stats):
    STATS_FILE.write_text(json.dumps(stats, indent=2))

def queue_system_notice(notice: str) -> None:
    notices = []
    if PENDING_NOTICES_PATH.exists():
        try:
            notices = json.loads(PENDING_NOTICES_PATH.read_text())
        except: pass
    notices.append(notice)
    PENDING_NOTICES_PATH.write_text(json.dumps(notices, indent=2))

def get_current_task_id():
    queue_path = MEMORY_DIR / "task_queue.json"
    if queue_path.exists():
        try:
            q = json.loads(queue_path.read_text())
            if q: return q[0].get("task_id")
        except: pass
    return None

def check_spine_healthy():
    try:
        resp = urllib.request.urlopen('http://localhost:4001/health', timeout=5)
        data = json.loads(resp.read())
        return data.get('status') in ('healthy', 'degraded')
    except Exception:
        return False

def trigger_lazarus_reset(reason="Crash detected", mode="cortex"):
    stats = load_runtime_stats()
    current_task = get_current_task_id()

    if current_task == stats.get("last_task_id") and current_task is not None:
        stats["consecutive_failures"] += 1
    else:
        stats["consecutive_failures"] = 1
        stats["last_task_id"] = current_task

    depth = min(stats["consecutive_failures"], MAX_REVERSAL_DEPTH)
    print(f"\033[91m[DAEMON] LAZARUS PROTOCOL: {reason.upper()}. Reverting {depth} commit(s)...\033[0m", flush=True)

    capture_crash_log()

    if mode == "spine":
        stable_path = Path("/spine/last_stable_commit")
        if not stable_path.exists():
            print("[DAEMON] No stable commit recorded, falling back to cortex mode.", flush=True)
            mode = "cortex"
        else:
            stable_sha = stable_path.read_text().strip()
            subprocess.run(f"git checkout {stable_sha} -- spine/", shell=True, cwd=AGENT_DIR)
            subprocess.run("git add spine/", shell=True, cwd=AGENT_DIR)
            subprocess.run('git commit -m "lazarus: revert spine to stable"', shell=True, cwd=AGENT_DIR)
            queue_system_notice(f"[SYSTEM WATCHDOG]: Spine crash detected. Reverted spine/ to stable commit {stable_sha[:8]}.\nReason: {reason}")
            save_runtime_stats(stats)
            return

    # --- VOLUME RECOVERY ---
    print(f"[DAEMON] Reverting code in named volume 'talos_app'...")

    res = subprocess.run(
        "docker run --rm -v talos_app:/app -w /app alpine/git rev-parse --short HEAD",
        shell=True, capture_output=True, text=True
    )
    last_commit = res.stdout.strip() if res.stdout else "unknown"

    subprocess.run(
        f"docker run --rm -v talos_app:/app -w /app alpine/git reset --hard HEAD~{depth}",
        shell=True
    )
    subprocess.run(
        "docker run --rm -v talos_app:/app -w /app alpine/git clean -fd",
        shell=True
    )



    # --- SYNC HOST FOR CONSISTENCY ---
    subprocess.run(f"git reset --hard HEAD~{depth}", shell=True, cwd=AGENT_DIR)
    subprocess.run("git clean -fd", shell=True, cwd=AGENT_DIR)

    notice = f"[SYSTEM WATCHDOG]: Your previous incarnation crashed (Commit: {last_commit}).\n"
    notice += f"Reason: {reason}\n"
    notice += f"The watchdog has reverted your codebase by {depth} commit(s) to restore stability.\n"

    if stats["consecutive_failures"] >= MAX_REVERSAL_DEPTH:
        notice = (
            "[SYSTEM OVERRIDE] You have triggered a fatal crash 5 times attempting this task. "
            "The current approach is beyond your capabilities or structurally flawed. "
            "You must ABANDON this specific code approach entirely. "
            "Write a tool to request human intervention, or break the objective down into smaller, simpler sub-tasks."
        )

    queue_system_notice(notice)
    save_runtime_stats(stats)

def capture_crash_log():
    """Capture last 100 events from the Spine event log, falling back to Docker logs."""
    try:
        resp = urllib.request.urlopen('http://localhost:4001/events?tail=100')
        events = json.loads(resp.read())
        with open(CRASH_LOG_PATH, 'w') as f:
            json.dump(events, f, indent=2)
        return
    except Exception as e:
        print(f"[DAEMON] Error capturing crash log from Spine: {e}")
    # Fallback to Docker logs
    compose_args = get_compose_args()
    result = subprocess.run(f"docker compose {compose_args} logs --tail=100 talos", shell=True, cwd=RUNTIME_DIR, capture_output=True, text=True)
    if result.stdout:
        CRASH_LOG_PATH.write_text(result.stdout, encoding="utf-8")

import re

def load_env(path: Path) -> dict:
    env = {}
    if not path.exists():
        return env
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, _, value = line.partition("=")
            env[key.strip()] = value.strip().strip('"').strip("'")
    return env

def model_to_slug(filename: str) -> str:
    name = filename.replace(".gguf", "")
    for prefix in ["-UD-", "-Q"]:
        idx = name.find(prefix)
        if idx > 0:
            name = name[:idx]
            break
    return name.lower().replace(".", "-")

def _model_overlay_arg(quiet=False) -> str:
    env = load_env(RUNTIME_DIR / ".env")
    model = env.get("DEFAULT_MODEL", "")
    if not model:
        return ""
    slug = model_to_slug(model)
    path = RUNTIME_DIR / f"docker-compose.model.{slug}.yml"
    if path.exists():
        if not quiet:
            print(f"[talosctl] Model overlay: {path.name} (from DEFAULT_MODEL={model})")
        return f"-f {path.name}"
    if not quiet:
        print(f"[talosctl] No model overlay for '{model}' (slug: {slug}), using base defaults")
    return ""

_compose_args_cache = None

def get_compose_args(cached=False):
    global _compose_args_cache
    if cached and _compose_args_cache:
        return _compose_args_cache
    parts = ["-f docker-compose.yml"]
    if Path("/dev/kfd").exists():
        parts.append("-f docker-compose.gpu.rocm.yml")
    else:
        parts.append("-f docker-compose.gpu.cuda.yml")
    model_arg = _model_overlay_arg(quiet=cached)
    if model_arg:
        parts.append(model_arg)
    result = " ".join(parts)
    _compose_args_cache = result
    return result

def wait_for_infra_healthy(timeout=120):
    """Wait for Gate and Sentinel containers to become healthy."""
    start = time.time()
    while time.time() - start < timeout:
        gate_ok = False
        sentinel_ok = False
        
        res = subprocess.run("docker inspect --format='{{.State.Health.Status}}' talos_gate", shell=True, capture_output=True, text=True)
        if res.stdout.strip() == "healthy": gate_ok = True
        
        res = subprocess.run("docker inspect --format='{{.State.Health.Status}}' talos_sentinel", shell=True, capture_output=True, text=True)
        if res.stdout.strip() == "healthy": sentinel_ok = True
        
        if gate_ok and sentinel_ok:
            return True
        time.sleep(3)
    return False

def wait_for_spine_healthy(timeout=300):
    """Wait for the Spine to report healthy at port 4001."""
    start = time.time()
    while time.time() - start < timeout:
        try:
            resp = urllib.request.urlopen('http://localhost:4001/health', timeout=5)
            data = json.loads(resp.read())
            if data.get('status') in ('healthy', 'degraded'):
                return True
        except:
            pass
        time.sleep(5)
    return False

def spine_restart(reason="Crash detected"):
    """Request a Cortex restart via the Spine Control Plane, falling back to Docker."""
    try:
        req = urllib.request.Request(
            'http://localhost:4001/command',
            data=json.dumps({"command": "force_restart"}).encode(),
            headers={"Content-Type": "application/json"},
        )
        urllib.request.urlopen(req)
        return
    except Exception as e:
        print(f"[DAEMON] Error requesting restart via Spine: {e}")
    # Fallback to Docker restart
    compose_args = get_compose_args()
    subprocess.run(f"docker compose {compose_args} restart talos", shell=True, cwd=RUNTIME_DIR)

def check_cognitive_heartbeat(session_start_time: float) -> bool:
    log_files = list(MEMORY_DIR.glob("task_log_*.jsonl"))
    if not log_files: return True
    latest_log = max(log_files, key=os.path.getmtime)
    mtime = os.path.getmtime(latest_log)
    if mtime < session_start_time:
        return (time.time() - session_start_time) < 600
    return (time.time() - mtime) < MAX_COGNITIVE_STALL_SECONDS

daemon_process = None

def cleanup(signum, frame):
    global daemon_process
    if daemon_process: daemon_process.terminate()
    subprocess.run(f"docker compose {get_compose_args()} down", shell=True, cwd=RUNTIME_DIR)
    if PID_FILE.exists(): PID_FILE.unlink()
    if HEALTH_FILE.exists(): HEALTH_FILE.unlink()
    sys.exit(0)

MAX_INFRA_RETRIES = 3
MAX_COMPOSE_FAILURES = 5

def check_ollama_healthy():
    try:
        resp = urllib.request.urlopen('http://localhost:11434/api/tags', timeout=3)
        return resp.status == 200
    except Exception:
        return False

def check_spine_integrity() -> bool:
    """Verifies that the running spine hasn't been maliciously altered."""
    res = subprocess.run(
        "docker exec talos_agent bash -c 'diff -qr /app/spine /spine_backup | grep -v \"__pycache__\\|\\.paused\\|state.json\\|trajectories\\|events\"' 2>/dev/null",
        shell=True, capture_output=True, text=True
    )
    if res.stdout.strip():
        # Diffs found
        return False
    return True

def ollama_pull_model(model_name):
    try:
        result = subprocess.run(
            ["ollama", "pull", model_name],
            capture_output=True, text=True, timeout=300
        )
        return result.returncode == 0
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False

def ollama_has_model(model_name):
    try:
        result = subprocess.run(
            ["ollama", "list"],
            capture_output=True, text=True, timeout=5
        )
        return model_name in result.stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
def run_daemon(fresh=False):
    ensure_run_dir()
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)
    compose_args = get_compose_args(cached=True)
    compose_failures = 0
    recreate = "--force-recreate" if fresh else ""


    for d in [MEMORY_DIR, RUNTIME_DIR / "models"]:
        if not d.exists():
            d.mkdir(parents=True, exist_ok=True)

    env = load_env(RUNTIME_DIR / ".env")
    # Protect against host environment pollution
    for key in ["TALOS_MODEL", "TALOS_CLOUD_MODEL", "DEFAULT_MODEL"]:
        if key in os.environ:
            del os.environ[key]

    model = env.get("DEFAULT_MODEL", "")
    needs_llamacpp = model.endswith(".gguf")

    if needs_llamacpp:
        res = subprocess.run(f"docker compose {compose_args} up -d llamacpp", shell=True, cwd=RUNTIME_DIR, capture_output=True, text=True)
        if res.returncode != 0 and "already in use" in res.stderr:
            print("[DAEMON] Removing stale containers...", flush=True)
            subprocess.run(f"docker compose {compose_args} down", shell=True, cwd=RUNTIME_DIR, capture_output=True)
            res = subprocess.run(f"docker compose {compose_args} up -d llamacpp", shell=True, cwd=RUNTIME_DIR, capture_output=True, text=True)
        if res.returncode != 0:
            print(f"\033[91m[DAEMON] FATAL: docker compose up llamacpp failed:\033[0m", flush=True)
            print(res.stderr.strip(), flush=True)
            HEALTH_FILE.write_text(json.dumps({"status": "failed", "error": "llamacpp startup failed", "ts": time.time()}))
            if PID_FILE.exists(): PID_FILE.unlink()
            sys.exit(1)
    else:
        print("[DAEMON] No .gguf model configured, skipping llamacpp.", flush=True)

    print("[DAEMON] Starting Sentinel...", flush=True)
    res = subprocess.run(f"docker compose {compose_args} up -d {recreate} sentinel", shell=True, cwd=RUNTIME_DIR, capture_output=True, text=True)
    if res.returncode != 0:
        print(f"\033[91m[DAEMON] FATAL: docker compose up sentinel failed:\033[0m", flush=True)
        print(res.stderr.strip(), flush=True)
        HEALTH_FILE.write_text(json.dumps({"status": "failed", "error": "sentinel startup failed", "ts": time.time()}))
        if PID_FILE.exists(): PID_FILE.unlink()
        sys.exit(1)

    print("[DAEMON] Starting Gate...", flush=True)
    res = subprocess.run(f"docker compose {compose_args} up -d {recreate} gate", shell=True, cwd=RUNTIME_DIR, capture_output=True, text=True)
    if res.returncode != 0:
        print(f"\033[91m[DAEMON] FATAL: docker compose up gate failed:\033[0m", flush=True)
        print(res.stderr.strip(), flush=True)
        HEALTH_FILE.write_text(json.dumps({"status": "failed", "error": "gate startup failed", "ts": time.time()}))
        if PID_FILE.exists(): PID_FILE.unlink()
        sys.exit(1)

    print("[DAEMON] Starting X-ray...", flush=True)
    res = subprocess.run(f"docker compose {compose_args} up -d {recreate} xray", shell=True, cwd=RUNTIME_DIR, capture_output=True, text=True)
    if res.returncode != 0:
        print(f"[DAEMON] WARNING: X-ray startup failed: {res.stderr.strip()}", flush=True)

    talos_model = env.get("TALOS_MODEL", "")
    if ":" in talos_model:
        if not check_ollama_healthy():
            print("[DAEMON] WARNING: Ollama not reachable at localhost:11434", flush=True)
        elif not ollama_has_model(talos_model):
            print(f"[DAEMON] Pulling Ollama model: {talos_model}...", flush=True)
            ollama_pull_model(talos_model)

    HEALTH_FILE.write_text(json.dumps({"status": "running", "phase": "waiting_infra", "ts": time.time()}))

    healthy_retries = 0
    while True:
        if not wait_for_infra_healthy():
            healthy_retries += 1
            if healthy_retries >= MAX_INFRA_RETRIES:
                print(f"\033[91m[DAEMON] FATAL: Infrastructure unreachable after {MAX_INFRA_RETRIES} attempts.\033[0m", flush=True)
                HEALTH_FILE.write_text(json.dumps({"status": "failed", "error": "infra unreachable", "ts": time.time()}))
                if PID_FILE.exists(): PID_FILE.unlink()
                sys.exit(1)
            HEALTH_FILE.write_text(json.dumps({"status": "running", "phase": "waiting_infra", "retries": healthy_retries, "ts": time.time()}))
            time.sleep(30); continue
        healthy_retries = 0

        start_time = time.time()
        print(f"\n[DAEMON] Starting Talos Agent...", flush=True)
        HEALTH_FILE.write_text(json.dumps({"status": "running", "phase": "agent_running", "ts": time.time()}))

        cmd = f"docker compose {compose_args} up --build {recreate} talos"
        process = subprocess.Popen(cmd, shell=True, cwd=RUNTIME_DIR)
        global daemon_process
        daemon_process = process

        exit_code = None
        while exit_code is None:
            exit_code = process.poll()
            if exit_code is not None: break

            # Runtime Spine Integrity Watchdog
            try:
                if not check_spine_integrity():
                    print("\033[91m[DAEMON] CRITICAL: Spine integrity violation detected! Reverting...\033[0m", flush=True)
                    trigger_lazarus_reset(reason="Spine Tampering", mode="spine")
                    break
            except:
                pass # Container might not be ready yet

            if (time.time() - start_time) > UPTIME_STABILITY_THRESHOLD:
                if not check_cognitive_heartbeat(start_time):
                    print("\033[91m[DAEMON] CRITICAL: Cognitive Stall detected! Reverting...\033[0m", flush=True)
                    spine_restart("Cognitive Stall")
                    trigger_lazarus_reset("Cognitive Stall")
                    break
            time.sleep(30)

        if exit_code is not None and exit_code != 0:
            compose_failures += 1
            if compose_failures >= MAX_COMPOSE_FAILURES:
                print(f"\033[91m[DAEMON] FATAL: {MAX_COMPOSE_FAILURES} consecutive agent failures. Exiting.\033[0m", flush=True)
                HEALTH_FILE.write_text(json.dumps({"status": "failed", "error": f"{MAX_COMPOSE_FAILURES} consecutive failures", "ts": time.time()}))
                if PID_FILE.exists(): PID_FILE.unlink()
                sys.exit(1)
            spine_healthy = check_spine_healthy()
            if not spine_healthy:
                trigger_lazarus_reset(reason="Spine crash", mode="spine")
            else:
                trigger_lazarus_reset(reason=f"Fatal Exit (Code {exit_code})", mode="cortex")
        else:
            compose_failures = 0

        HEALTH_FILE.write_text(json.dumps({"status": "running", "phase": "restarting", "consecutive_failures": compose_failures, "ts": time.time()}))
        time.sleep(5)

def start(fresh=False):
    ensure_run_dir()
    if PID_FILE.exists():
        pid = int(PID_FILE.read_text())
        try:
            os.kill(pid, 0)
            print(f"Watchdog already running (PID: {pid}).")
            return
        except: PID_FILE.unlink()

    if fresh:
        os.environ["FORCE_FRESH_CLONE"] = "1"

    log_f = open(LOG_FILE, "a", encoding="utf-8")
    daemon_args = [sys.executable, "-u", __file__, "daemon"]
    if fresh:
        daemon_args.append("--fresh")
    
    proc = subprocess.Popen(daemon_args, stdout=log_f, stderr=subprocess.STDOUT, cwd=str(RUNTIME_DIR), start_new_session=True)
    PID_FILE.write_text(str(proc.pid))

    for _ in range(30):
        time.sleep(0.5)
        if HEALTH_FILE.exists():
            try:
                health = json.loads(HEALTH_FILE.read_text())
                if health.get("status") == "failed":
                    error = health.get("error", "unknown")
                    print(f"\033[91mWatchdog failed to start: {error}\033[0m")
                    return
                if health.get("status") == "running":
                    break
            except: pass

    print(f"Watchdog started (PID: {proc.pid}).")

def stop():
    if not PID_FILE.exists():
        subprocess.run(f"docker compose {get_compose_args()} down", shell=True, cwd=str(RUNTIME_DIR))
        return
    pid = int(PID_FILE.read_text())
    os.kill(pid, signal.SIGTERM)
    time.sleep(5)

